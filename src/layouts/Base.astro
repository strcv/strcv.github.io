---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { dicts, type Lang, languages, localePath } from '../i18n'

interface Props {
  lang: Lang
  /** Путь без языкового префикса: '/' или '/cases/marsbase-otc/'. */
  neutralPath: string
  /** Заголовок страницы. Для главной не передаётся — берётся из словаря. */
  title?: string
  description?: string
  /** Убрать из индексации: страница 404. */
  noindex?: boolean
  /**
   * false — страница есть только на языке `lang` и перевода не будет: без
   * hreflang-альтернатив и без переключателя языка в шапке.
   */
  translated?: boolean
}

const {
  lang,
  neutralPath,
  title,
  description,
  noindex = false,
  translated = true,
} = Astro.props
const dict = dicts[lang]

const pageTitle = title ? `${title} — ${dict.hero.name}` : dict.meta.title
const pageDescription = description ?? dict.meta.description

const origin = Astro.site ?? new URL('http://localhost:4321')
const canonical = new URL(localePath(neutralPath, lang), origin)
const ogImage = new URL(lang === 'ru' ? '/og.png' : '/og-en.png', origin)
---

<!doctype html>
<html lang={dict.lang} dir={dict.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}

    {
      translated && (
        <>
          {languages.map((l) => (
            <link
              rel="alternate"
              hreflang={l}
              href={new URL(localePath(neutralPath, l), origin).href}
            />
          ))}
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(localePath(neutralPath, 'ru'), origin).href}
          />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.hero.name} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a href="#main" class="skip">{dict.skipToContent}</a>
    <Header lang={lang} dict={dict} neutralPath={neutralPath} showLangSwitch={translated} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer dict={dict} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    flex: 1;
  }
</style>
