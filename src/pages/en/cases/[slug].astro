---
import { getCollection } from 'astro:content'
import Case from '../../../components/Case.astro'
import { dicts } from '../../../i18n'
import Base from '../../../layouts/Base.astro'

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ id }) => id.startsWith('en/'))
  return entries.map((entry) => ({
    params: { slug: entry.id.slice('en/'.length) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const t = dicts.en
const teaser = t.cases.items.find((c) => c.slug === entry.id.slice('en/'.length))
---

<Base
  lang="en"
  neutralPath={`/cases/${entry.id.slice('en/'.length)}/`}
  title={entry.data.title}
  description={teaser?.summary ?? entry.data.title}
>
  <Case lang="en" entry={entry} />
</Base>
