---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { site } from '../site.config'

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3)

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

const fmt = new Intl.DateTimeFormat('ru-RU', { year: 'numeric', month: 'long' })
---

<Base>
  <section class="intro">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <div class="stack bio">
      {site.bio.map((line) => <p class="muted">{line}</p>)}
    </div>
    <div class="links">
      {
        site.links.map((l) => (
          <a href={l.href} rel="me noopener">
            {l.label}
            <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
              <path
                d="M3 9 9 3M4.2 3H9v4.8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <h2>Сейчас</h2>
    <ul class="now">
      {site.now.map((item) => <li class="muted">{item}</li>)}
    </ul>
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <div class="head">
          <h2>Проекты</h2>
          <a href="/projects" class="small muted">
            все →
          </a>
        </div>
        <ul class="list">
          {projects.map((p) => (
            <li>
              <a href={`/projects/${p.id}`}>
                <span class="row">
                  <span class="title">{p.data.title}</span>
                  <span class="mono">{p.data.year}</span>
                </span>
                <span class="muted small">{p.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <div class="head">
          <h2>Заметки</h2>
          <a href="/blog" class="small muted">
            все →
          </a>
        </div>
        <ul class="list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`}>
                <span class="row">
                  <span class="title">{post.data.title}</span>
                  <span class="mono">{fmt.format(post.data.date)}</span>
                </span>
                <span class="muted small">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .intro h1 {
    margin-bottom: var(--space-2);
  }
  .tagline {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
  .bio {
    margin-top: var(--space-6);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-muted);
    transition: border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .links a:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .links svg {
    opacity: 0.5;
  }

  .now {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .now li {
    padding-left: var(--space-4);
    position: relative;
    max-width: var(--measure);
  }
  .now li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }
  .head h2 {
    margin: 0;
  }
  .head a {
    text-decoration: none;
  }

  .list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .list a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  .list a:hover {
    background: var(--bg-subtle);
    color: inherit;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .title {
    font-weight: 550;
  }
  .list a:hover .title {
    color: var(--accent);
  }
</style>
