---
import { getCollection } from 'astro:content'
import Case from '../../components/Case.astro'
import { dicts } from '../../i18n'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const entries = await getCollection('cases', ({ id }) => id.startsWith('ru/'))
  return entries.map((entry) => ({
    params: { slug: entry.id.slice('ru/'.length) },
    props: { entry },
  }))
}

const { entry } = Astro.props
const t = dicts.ru
const teaser = t.cases.items.find((c) => c.slug === entry.id.slice('ru/'.length))
---

<Base
  lang="ru"
  neutralPath={`/cases/${entry.id.slice('ru/'.length)}/`}
  title={entry.data.title}
  description={teaser?.summary ?? entry.data.title}
>
  <Case lang="ru" entry={entry} />
</Base>
