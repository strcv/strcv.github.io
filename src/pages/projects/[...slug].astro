---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
---

<Base title={project.data.title} description={project.data.summary}>
  <a href="/projects" class="back small muted">← Проекты</a>

  <article>
    <header>
      <h1>{project.data.title}</h1>
      <p class="muted">{project.data.summary}</p>
      <dl>
        <div><dt class="mono">Роль</dt><dd>{project.data.role}</dd></div>
        <div><dt class="mono">Год</dt><dd>{project.data.year}</dd></div>
        <div>
          <dt class="mono">Стек</dt><dd>{project.data.stack.join(' · ')}</dd>
        </div>
      </dl>
      {
        (project.data.url || project.data.repo) && (
          <p class="links small">
            {project.data.url && <a href={project.data.url}>Сайт →</a>}
            {project.data.repo && <a href={project.data.repo}>Код →</a>}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-8);
  }
  header h1 {
    margin-bottom: var(--space-2);
  }
  dl {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-block: var(--space-6);
    border-block: 1px solid var(--border);
  }
  dl > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
  }
  dd {
    margin: 0;
    font-size: var(--text-sm);
  }
  .links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .prose {
    margin-top: var(--space-12);
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: var(--space-4);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
    max-width: var(--measure);
  }
  .prose :global(li) + :global(li) {
    margin-top: var(--space-2);
  }
</style>
