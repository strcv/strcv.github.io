---
import { dicts, localePath } from '../i18n'
import Base from '../layouts/Base.astro'

const t = dicts.ru
---

<Base lang="ru" neutralPath="/404.html" title={t.notFound.title} description={t.notFound.body} noindex>
  <section class="nf">
    <div class="wrap wrap--wide">
      <p class="nf__n" aria-hidden="true">404</p>
      <h1 class="nf__t">{t.notFound.title}</h1>
      <p class="lead nf__b">{t.notFound.body}</p>
      <a class="btn btn--primary nf__a" href={localePath('/', 'ru')}>{t.notFound.back}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-top: var(--s24);
  }

  .nf__n {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    color: var(--dim);
  }

  .nf__t {
    margin-top: var(--s4);
    font-size: var(--fs-error);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 650;
  }

  .nf__b {
    margin-top: var(--s4);
  }

  .nf__a {
    margin-top: var(--s8);
  }
</style>
