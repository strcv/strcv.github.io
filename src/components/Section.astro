---
// Общий раздел с заголовком и разделительной линией.

interface Props {
  title: string
  id: string
  alt?: boolean
  wide?: boolean
}

const { title, id, alt = false, wide = false } = Astro.props
---

<section class:list={['section', { 'section--alt': alt }]} id={id}>
  <div class:list={['wrap', { 'wrap--wide': wide }]}>
    <div class="head">
      <h2 class="t">{title}</h2>
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-top: var(--s24);
  }

  .section--alt {
    background: var(--bg-2);
    padding-bottom: var(--s24);
  }

  .head {
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--s8);
  }

  .t {
    font-size: var(--fs-section);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .section { padding-top: var(--s16); }
    .section--alt { padding-bottom: var(--s16); }
    .head { margin-bottom: var(--s6); }
  }
</style>
