---
import type { Titled } from '../i18n/types'
interface Props { name: NonNullable<Titled['icon']> }
const { name } = Astro.props
const paths: Record<Props['name'], string[]> = {
  review: ['M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-9', 'm10 13 2.5-.5L21 4l-2-2-8.5 8.5L10 13Z', 'M7 17h10'],
  solve: ['M4 4h6v6H4zM14 14h6v6h-6z', 'M10 7h4a3 3 0 0 1 3 3v4', 'M14 17h-4a3 3 0 0 1-3-3v-4'],
  campaign: ['m3 10 14-6v16L3 14v-4Z', 'M7 16v5h4l-2-4M21 9v6'],
  crm: ['M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z', 'M17 4a4 4 0 0 1 0 7M22 21v-2a4 4 0 0 0-3-3.9'],
  network: ['M12 3a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM5 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM19 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z', 'm10 8-4 7m8-7 4 7M8 18h8'],
  automation: ['M6 6h12v12H6zM9 9h6v6H9z', 'M9 2v4m6-4v4M9 18v4m6-4v4M2 9h4m-4 6h4m12-6h4m-4 6h4'],
  retention: ['M3 11a9 9 0 1 1 2.6 7.4', 'M3 4v7h7', 'm9 13 3 3 5-6'],
  strategy: ['M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM19 17a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z', 'M7 5h9a4 4 0 0 1 0 8H8a3 3 0 0 0 0 6h9'],
  production: ['m12 3 10 5-10 5L2 8l10-5Z', 'm2 12 10 5 10-5M2 16l10 5 10-5'],
  integration: ['M8 3v4m8-4v4M6 7h12v3a6 6 0 0 1-12 0V7Z', 'M12 16v2a3 3 0 0 0 3 3h4'],
}
---
<svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {paths[name].map((d) => <path d={d} />)}
</svg>
<style>
  .feature-icon { display: block; width: var(--s6); height: var(--s6); }
</style>
