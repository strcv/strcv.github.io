---
import { site, emailHref } from '../site.config'

interface Props {
  href: string | null
}

const { href } = Astro.props
const kind = href === site.telegram ? 'telegram'
  : href === site.linkedin ? 'linkedin'
  : href === emailHref ? 'email' : null
---

{kind && (
  <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    {kind === 'telegram' && <path d="M21.5 3.5 18.2 20c-.2 1-1 1.2-1.8.7l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1L17.7 6c.4-.4-.1-.6-.6-.3L5.6 13 1 11.5c-1-.3-1-1 .2-1.5L20 2.8c.9-.3 1.7.2 1.5.7Z" />}
    {kind === 'linkedin' && <path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2ZM8 19H5V9h3ZM6.5 7.7a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4ZM19 19h-3v-5.3c0-1.3-.5-2-1.5-2-1.1 0-1.5.8-1.5 2V19h-3V9h3v1.4c.5-.9 1.5-1.6 2.8-1.6 2.1 0 3.2 1.4 3.2 4Z" />}
    {kind === 'email' && <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></g>}
  </svg>
)}

<style>
  .contact-icon {
    width: var(--icon-size);
    height: var(--icon-size);
    flex: 0 0 auto;
  }
</style>
