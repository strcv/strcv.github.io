---
// Одна длинная главная с именованными разделами.
// Порядок разделов задан в docs/tz.md и меняться не должен.
// Разметка общая для обоих языков — различаются только словари.

import { Image } from 'astro:assets'
import portrait from '../assets/owner-portrait.png'
import { dicts, type Lang, localePath } from '../i18n'
import ActionLink from './ActionLink.astro'
import ContactIcon from './ContactIcon.astro'
import FeatureIcon from './FeatureIcon.astro'
import Section from './Section.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = dicts[lang]
const pageSections = [
  { id: 'stats', section: t.stats },
  { id: 'principles', section: t.principles },
  { id: 'services', section: t.services },
  { id: 'cases', section: t.cases },
  { id: 'contacts', section: t.contacts },
]
---

<!-- 01. Первый экран -->
<section class="hero" id="hero">
  <div class="wrap wrap--wide">
    <div class="hero__identity">
      <p class="hero__name">{t.hero.name}</p>
      <Image
        class="hero__portrait"
        src={portrait}
        alt={t.hero.name}
        width={192}
        height={256}
        format="webp"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
      <h1 class="hero__h">{t.hero.headline}</h1>
    </div>
    <p class="hero__lead">{t.hero.lead}</p>
    <div class="hero__actions">
      {t.hero.actions.filter((link) => link.href).map((link, i) => <ActionLink link={link} primary={i === 0} />)}
    </div>
  </div>
</section>

<nav class="page-nav wrap wrap--wide" aria-label={lang === 'ru' ? 'На этой странице' : 'On this page'}>
  {pageSections.map(({ id, section }) => (
    <a href={`#${id}`}>{section.title}</a>
  ))}
</nav>

<!-- 02. Цифры -->
<Section title={t.stats.title} id="stats" wide>
  <ul class="tiles">
    {
      t.stats.items.map((s) => (
        <li class="tile">
          <span class="tile__v">{s.value}</span>
          <span class="tile__l">{s.label}</span>
        </li>
      ))
    }
  </ul>
  <p class="tiles__note dim">{t.stats.note}</p>
</Section>

<!-- 03. Что я умею -->
<Section title={t.skills.title} id="skills" wide>
  <div class="feature-grid">
    {
      t.skills.items.map((item) => (
        <article class="block feature-card">
          {item.icon && <span class="feature-card__icon"><FeatureIcon name={item.icon} /></span>}
          <h3 class="block__t">{item.title}</h3>
          <p class="block__b measure">{item.body}</p>
        </article>
      ))
    }
  </div>
</Section>

<!-- 04. Как я работаю -->
<Section title={t.principles.title} id="principles" wide>
  <div class="stack">
    {
      t.principles.items.map((item) => (
        <article class="block">
          <h3 class="block__t">{item.title}</h3>
          <p class="block__b measure">{item.body}</p>
        </article>
      ))
    }
  </div>
</Section>

<!-- 05. С кем мне по пути -->
<Section title={t.fit.title} id="fit" wide alt>
  <div class="fit">
    <div>
      <h3 class="fit__t">{t.fit.goodTitle}</h3>
      <ul class="fit__l">
        {
          t.fit.good.map((line) => (
            <li>
              <span class="mark mark--ok" aria-hidden="true">
                ✓
              </span>
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="fit__t">{t.fit.badTitle}</h3>
      <ul class="fit__l">
        {
          t.fit.bad.map((line) => (
            <li>
              <span class="mark mark--no" aria-hidden="true">
                ✕
              </span>
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<!-- 06. Со мной можно работать -->
<Section title={t.services.title} id="services" wide>
  <p class="lead services__lead">{t.services.lead}</p>
  <div class="feature-grid">
    {
      t.services.items.map((item) => (
        <article class="block feature-card">
          {item.icon && <span class="feature-card__icon"><FeatureIcon name={item.icon} /></span>}
          <h3 class="block__t">{item.title}</h3>
          <p class="block__b measure">{item.body}</p>
        </article>
      ))
    }
  </div>
  <div class="services__cta">
    <ActionLink link={t.services.cta} primary />
  </div>
</Section>

<!-- 07. Кейсы -->
<Section title={t.cases.title} id="cases" wide>
  <ul class="cards">
    {
      t.cases.items.map((c) => (
        <li>
          <a class="card" href={localePath(`/cases/${c.slug}/`, lang)}>
            <h3 class="card__t">{c.title}</h3>
            {c.meta && <p class="card__m dim">{c.meta}</p>}
            <p class="card__s">{c.summary}</p>
            <span class="card__more" aria-hidden="true">
              {t.cases.more} →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<!-- 08. Опыт -->
<Section title={t.experience.title} id="experience" wide>
  <table class="cv">
    <caption class="sr">{t.experience.title}</caption>
    <thead class="sr">
      <tr>
        <th scope="col">{t.experience.colPeriod}</th>
        <th scope="col">{t.experience.colCompany}</th>
        <th scope="col">{t.experience.colRole}</th>
      </tr>
    </thead>
    <tbody>
      {
        t.experience.rows.map((r) => (
          <tr>
            <td class="cv__p">{r.period}</td>
            <td class="cv__c">{r.company}</td>
            <td class="cv__r">{r.role}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p class="cv__edu">{t.experience.education}</p>
  <ul class="cv__links">
    {
      t.experience.links.filter((link) => link.href).map((l) => (
        <li>
          <a class="ext" href={l.href} rel="noopener" target="_blank">
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<!-- 09. Пет-проекты -->
<Section title={t.pets.title} id="pets" wide>
  <p class="lead services__lead">{t.pets.lead}</p>
  <div class="stack">
    {
      t.pets.items.map((item) => (
        <article class="block">
          <h3 class="block__t">{item.title}</h3>
          <p class="block__b measure">{item.body}</p>
        </article>
      ))
    }
  </div>
</Section>

<!-- 10. Контакты -->
<Section title={t.contacts.title} id="contacts" wide>
  <p class="lead services__lead">{t.contacts.lead}</p>
  <ul class="contacts">
    {
      t.contacts.items.filter((link) => link.href).map((l) => (
        <li class="contacts__i">
          <span class="contacts__k dim">{l.label}</span>
          <a class="contacts__v" href={l.href} rel="noopener">
            <ContactIcon href={l.href} />
            <span>{l.note ?? l.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .page-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s6);
  }
  .page-nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: var(--tap);
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .page-nav a:hover { color: var(--text); }

  /* ─── 01. Первый экран ─── */

  .hero {
    overflow-wrap: anywhere;
    position: relative;
    padding-top: var(--s24);
    padding-bottom: var(--s16);
  }

  /* Мягкая синяя подсветка первого экрана. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--hero-glow);
  }

  .hero > :global(.wrap) {
    position: relative;
  }

  .hero__identity {
    display: grid;
    grid-template-columns: var(--portrait-width) minmax(0, 1fr);
    grid-template-areas: 'portrait name' 'headline headline';
    align-items: center;
    gap: var(--s4);
  }

  .hero__portrait {
    grid-area: portrait;
    width: var(--portrait-width);
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    flex: 0 0 auto;
  }

  .hero__name {
    grid-area: name;
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--muted);
  }

  .hero__h {
    grid-area: headline;
    text-wrap: balance;
    min-width: 0;
    font-size: var(--fs-hero);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 650;
    max-width: 18ch;
  }

  @media (max-width: 40rem) {
    .hero__identity {
      grid-template-columns: var(--s16) minmax(0, 1fr);
      grid-template-areas: 'portrait name' 'headline headline';
    }

    .hero__portrait {
      width: var(--s16);
    }
  }

  .hero__lead {
    margin-top: var(--s6);
    max-width: var(--measure);
    color: var(--muted);
  }

  .hero__actions {
    margin-top: var(--s8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }

  @media (max-width: 40rem) {
    .hero { padding-block: var(--s6) var(--s8); }
    .hero__identity { row-gap: var(--s6); }
    .hero__name { color: var(--text); }
    .hero__h {
      font-size: var(--fs-hero-mobile);
      line-height: 1.1;
      max-width: none;
    }
    .hero__lead {
      margin-top: var(--s4);
      font-size: var(--s4);
      line-height: 1.6;
    }
    .hero__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--s6);
    }
    .hero__actions :global(.btn) { justify-content: center; }
    .page-nav {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: var(--s2);
      padding-bottom: var(--s2);
    }
    .page-nav a {
      flex: 0 0 auto;
      padding-inline: var(--s3);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }
  }

  /* ─── 02. Цифры ─── */

  .tiles {
    display: grid;
    /* 17rem, а не меньше: при более узкой колонке «$10 млн+» разрывается пополам. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--tile-min)), 1fr));
    gap: var(--s4);
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--s6);
    transition: border-color var(--dur) var(--ease);
  }

  .tile:hover {
    border-color: var(--line-2);
  }

  .tile__v {
    font-size: var(--fs-stat);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    /* Цифра — одно целое: «$10 млн+» и «500 000» не разрываются переносом. */
    white-space: nowrap;
  }

  .tile__l {
    color: var(--muted);
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .tiles__note {
    margin-top: var(--s4);
    font-size: var(--fs-sm);
  }

  /* ─── 03, 04, 06, 09. Текстовые блоки ─── */

  .stack {
    display: grid;
    gap: var(--s8);
  }

  .block__t {
    font-size: var(--fs-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .block__b {
    margin-top: var(--s2);
    color: var(--muted);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4);
  }

  .feature-card {
    padding: var(--s8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--s12);
    height: var(--s12);
    margin-bottom: var(--s6);
    color: var(--accent-2);
    background: var(--accent-soft);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__identity, .hero__lead, .hero__actions {
      animation: intro-enter var(--dur-enter) var(--ease) both;
    }
    .hero__lead { animation-delay: var(--delay-intro); }
    .hero__actions { animation-delay: calc(var(--delay-intro) * 2); }
    .feature-card__icon {
      transition: transform var(--dur) var(--ease);
    }
    @media (hover: hover) and (pointer: fine) {
      .feature-card:hover .feature-card__icon {
        transform: translateY(calc(var(--s1) * -1));
      }
    }
  }

  @keyframes intro-enter {
    from { opacity: 0; transform: translateY(var(--s2)); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 40rem) {
    .feature-grid { grid-template-columns: minmax(0, 1fr); }
    .feature-card { padding: var(--s6); }
    .feature-card__icon { margin-bottom: var(--s4); }
  }

  .services__lead {
    margin-bottom: var(--s8);
  }

  .services__cta {
    margin-top: var(--s8);
  }

  /* ─── 05. С кем мне по пути ─── */

  .fit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
    gap: var(--s8) var(--s12);
  }

  .fit__t {
    font-size: var(--fs-base);
    font-weight: 600;
    margin-bottom: var(--s4);
  }

  .fit__l {
    display: grid;
    gap: var(--s3);
  }

  .fit__l li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-items: start;
    color: var(--muted);
    line-height: 1.55;
  }

  .mark {
    font-weight: 600;
  }

  .mark--ok {
    color: var(--ok);
  }

  .mark--no {
    color: var(--no);
  }

  /* ─── 07. Кейсы ─── */

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
    gap: var(--s4);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    height: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--s6);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .card:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }

  .card__t {
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .card__m {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
  }

  .card__s {
    color: var(--muted);
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .card__more {
    margin-top: auto;
    padding-top: var(--s3);
    color: var(--accent-2);
    font-size: var(--fs-sm);
  }

  /* ─── 08. Опыт ─── */

  .cv {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-md);
  }

  .cv td {
    padding: var(--s3) var(--s4) var(--s3) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: baseline;
  }

  .cv tr:last-child td {
    border-bottom: 0;
  }

  .cv__p {
    font-family: var(--mono);
    font-size: var(--fs-tiny);
    color: var(--dim);
    white-space: nowrap;
    width: 1%;
  }

  .cv__c {
    font-weight: 600;
    white-space: nowrap;
  }

  .cv__r {
    color: var(--muted);
  }

  .cv__edu {
    margin-top: var(--s6);
    color: var(--muted);
    font-size: var(--fs-md);
  }

  .cv__links {
    margin-top: var(--s4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s6);
    font-size: var(--fs-md);
  }

  .ext {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: var(--tap);
    color: var(--accent-2);
  }

  /* ─── 10. Контакты ─── */

  .contacts {
    display: grid;
    gap: var(--s2);
  }

  .contacts__i {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s4);
    min-height: var(--tap);
  }

  .contacts__k {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-width: 8ch;
  }

  .contacts__v {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    max-width: 100%;
    min-height: var(--tap);
    overflow-wrap: anywhere;
    color: var(--accent-2);
    transition: color var(--dur) var(--ease);
  }

  .contacts__v:hover {
    color: var(--text);
  }

  /* Заголовки таблицы нужны скринридеру, но не глазу. */
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 34rem) {
    .cv,
    .cv tbody,
    .cv tr,
    .cv td {
      display: block;
      width: auto;
    }

    .cv tr {
      padding-block: var(--s3);
      border-bottom: 1px solid var(--line);
    }

    .cv tr:last-child {
      border-bottom: 0;
    }

    .cv td {
      padding: 0;
      border-bottom: 0;
      white-space: normal;
    }

    .cv__p {
      margin-bottom: var(--s1);
    }
  }
  @media (max-width: 40rem) {
    .tile { padding: var(--s4); }
    .stack { gap: var(--s6); }
  }
</style>
