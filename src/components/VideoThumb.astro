---
// Обложка ролика: своя картинка, кадр с YouTube или заглушка того же размера, чтобы
// строки списка стояли ровно. Плашки поверх (длительность, «Смотреть») — слотом.

import { coverUrl } from '../lib/video'

interface Props {
  thumb: string | null
  videoId: string | null
  /** Большая обложка разбора: крупнее радиус и значок, картинка грузится сразу. */
  large?: boolean
}

const { thumb, videoId, large = false } = Astro.props
const src = coverUrl(thumb, videoId, large ? 'hq' : 'mq')
---

<span class:list={['thumb', { 'thumb--lg': large }]}>
  {
    src ? (
      <img
        src={src}
        alt=""
        width="320"
        height="180"
        loading={large ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <svg class="thumb__ph" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 5.5v13l10.5-6.5z" />
      </svg>
    )
  }
  <slot />
</span>

<style>
  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .thumb--lg {
    border-radius: var(--radius-lg);
  }

  /* Своя обложка бывает любого формата: кадрируем в 16:9, а не растягиваем. */
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb__ph {
    width: var(--s6);
    fill: var(--line-2);
  }

  .thumb--lg .thumb__ph {
    width: var(--s12);
  }
</style>
