---
import { emailHref } from '../site.config'
// Шапка: слева имя, справа меню разделов, переключатель языка и «Написать».
// Переключатель — обычные ссылки на тот же документ на другом языке, JS не нужен.
// На страницах без перевода его нет вовсе: выбирать не из чего.
// Меню у каждого языка своё (nav.menu в словаре): раздела может не быть в переводе.

import { type Dict, type Lang, localePath } from '../i18n'

interface Props {
  lang: Lang
  dict: Dict
  /** Путь без языкового префикса: '/' или '/cases/marsbase-otc/'. */
  neutralPath: string
  /** false — страница есть только на одном языке, переключатель не показываем. */
  showLangSwitch?: boolean
}

const { lang, dict, neutralPath, showLangSwitch = true } = Astro.props

// Раздел отмечен и на своих вложенных страницах: /watch-later/ и /watch-later/<slug>/.
const menu = dict.nav.menu.map((item) => ({
  label: item.label,
  href: localePath(item.path, lang),
  current:
    neutralPath === item.path
      ? ('page' as const)
      : neutralPath.startsWith(item.path)
        ? ('true' as const)
        : undefined,
}))
---

<header class="top">
  <div class="wrap wrap--wide inner">
    <a class="name" href={localePath('/', lang)}>{dict.nav.home}</a>

    <div class="right">
      {
        menu.length > 0 && (
          <nav class="menu" aria-label={dict.nav.menuLabel}>
            {menu.map((item) => (
              <a
                class:list={['menu__i', { 'is-on': item.current }]}
                href={item.href}
                aria-current={item.current}
              >
                {item.label}
              </a>
            ))}
          </nav>
        )
      }

      {
        showLangSwitch && (
          <nav class="lang" aria-label={dict.nav.langLabel}>
            <a
              class:list={['lang__i', { 'is-on': lang === 'ru' }]}
              href={localePath(neutralPath, 'ru')}
              hreflang="ru"
              lang="ru"
              aria-current={lang === 'ru' ? 'true' : undefined}>RU</a
            >
            <span class="lang__sep" aria-hidden="true">/</span>
            <a
              class:list={['lang__i', { 'is-on': lang === 'en' }]}
              href={localePath(neutralPath, 'en')}
              hreflang="en"
              lang="en"
              aria-current={lang === 'en' ? 'true' : undefined}>EN</a
            >
          </nav>
        )
      }

      <a class="write" href={emailHref}>{dict.nav.write}</a>
    </div>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    min-height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
  }

  .name {
    font-weight: 600;
    letter-spacing: -0.01em;
    /* На узком экране имя занимает отдельную строку. */
    min-width: 0;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    white-space: nowrap;
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex: 0 0 auto;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .menu__i {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-md);
    color: var(--muted);
    transition: color var(--dur) var(--ease);
  }

  .menu__i:hover,
  .menu__i.is-on {
    color: var(--text);
  }

  .lang {
    display: flex;
    align-items: center;
    gap: var(--s1);
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
  }

  .lang__i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    color: var(--dim);
    transition: color var(--dur) var(--ease);
  }

  .lang__i:hover,
  .lang__i.is-on {
    color: var(--text);
  }

  .lang__sep {
    color: var(--line-2);
  }

  .write {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--s4);
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    font-size: var(--fs-md);
    font-weight: 500;
    transition: border-color var(--dur) var(--ease);
  }

  .write:hover {
    border-color: var(--accent);
  }

  @media (max-width: 40rem) {
    .inner {
      flex-wrap: wrap;
      gap: 0;
      padding-block: var(--s2);
    }

    .name {
      flex: 1 1 100%;
    }

    .right {
      flex: 1 1 100%;
      justify-content: space-between;
      gap: var(--s2);
    }

    .write {
      margin-left: auto;
      padding-inline: var(--s3);
    }
  }
</style>
