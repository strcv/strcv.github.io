---
import type { Dict } from '../i18n'

interface Props {
  dict: Dict
}

const { dict } = Astro.props
const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="wrap wrap--wide bar">
    <span>© {year} {dict.footer.note}</span>
    <a href="mailto:insider2la@gmail.com">insider2la@gmail.com</a>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--s24);
    border-top: 1px solid var(--line);
    padding-block: var(--s8);
    color: var(--dim);
    font-size: 0.9375rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s6);
    align-items: center;
    justify-content: space-between;
  }

  .bar a {
    transition: color var(--dur) var(--ease);
  }

  .bar a:hover {
    color: var(--text);
  }
</style>
