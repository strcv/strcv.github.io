---
import { site, emailHref } from '../site.config'
import type { Dict } from '../i18n'

interface Props {
  dict: Dict
}

const { dict } = Astro.props
const year = new Date().getFullYear()
---

<footer class="foot">
  <div class="wrap wrap--wide bar">
    <span>© {year} {dict.footer.note}</span>
    <a href={emailHref}>{site.email}</a>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--s24);
    border-top: 1px solid var(--line);
    padding-block: var(--s8);
    color: var(--dim);
    font-size: var(--fs-md);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s6);
    align-items: center;
    justify-content: space-between;
  }

  .bar a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    transition: color var(--dur) var(--ease);
  }

  .bar a:hover {
    color: var(--text);
  }
</style>
